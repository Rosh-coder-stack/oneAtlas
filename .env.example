# ==============================================
# OneAtlas - Environment Configuration
# ==============================================
# Copy this file to `.env` for local development.
# Note: Do not commit `.env` containing sensitive credentials to version control.

# PostgreSQL Connection Strings for Prisma ORM
# For local Docker: DATABASE_URL and DIRECT_URL can be identical.
# For production (Neon / PgBouncer):
#   - DATABASE_URL: Pooled connection string (with -pooler host and ?sslmode=require)
#   - DIRECT_URL: Direct unpooled connection string (without -pooler host, for migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneatlas?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/oneatlas?schema=public"

# Application Settings
NEXT_PUBLIC_APP_NAME="OneAtlas"
NEXT_PUBLIC_APP_DESCRIPTION="AI Model Discovery & Intelligence Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
